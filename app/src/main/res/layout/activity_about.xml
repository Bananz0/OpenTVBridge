<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/surface"
            android:padding="16dp"
            android:text="@string/about_summary"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="640dp"
            android:text="@string/about_source_heading" />

        <TextView
            android:id="@+id/source"
            style="@style/SectionBody"
            android:layout_width="640dp"
            android:textIsSelectable="true" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="640dp"
            android:text="@string/about_warranty_heading" />

        <TextView
            style="@style/SectionBody"
            android:layout_width="640dp"
            android:text="@string/about_warranty" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="640dp"
            android:text="@string/about_third_party_heading" />

        <TextView
            style="@style/SectionBody"
            android:layout_width="640dp"
            android:text="@string/about_third_party" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="640dp"
            android:text="@string/about_trademarks_heading" />

        <TextView
            style="@style/SectionBody"
            android:layout_width="640dp"
            android:text="@string/about_trademarks" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="640dp"
            android:text="@string/about_licence_heading" />

        <TextView
            android:id="@+id/licence"
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
